BOT_TOKEN=123456:your-bot-token-from-BotFather
MINI_APP_URL=https://your-frontend-domain.example.com
BOT_USERNAME=adverscrm_bot

# Telegram numeric IDs allowed into the admin panel (comma-separated).
# Send /myid to your own bot to get your ID.
ADMIN_IDS=123456789

# Comma-separated list of origins allowed to call the API (your frontend domain).
CORS_ORIGINS=https://your-frontend-domain.example.com

# ── Database ──
# Supabase (Postgres) connection string. Get it from:
# Supabase project → Settings → Database → Connection string → URI
# (use the "Session pooler" URI if your host is serverless/short-lived,
# or the direct "postgresql://postgres:..." URI for a long-running server).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Only used as a fallback if DATABASE_URL is empty (local dev without Supabase).
DB_PATH=adverse.db

# How old (seconds) a Telegram initData payload can be before it's rejected.
MAX_AUTH_AGE_SECONDS=86400

# NEVER set this to true in production — it disables real Telegram signature
# verification and is only for local testing without a real Telegram client.
DEV_BYPASS=false
